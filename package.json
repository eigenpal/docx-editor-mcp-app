{
  "name": "docx-editor-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP App that opens, edits and returns .docx files inside Claude and ChatGPT, on the docx-editor.dev engine.",
  "author": "EigenPal",
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor-mcp-app.git"
  },
  "keywords": [
    "mcp",
    "mcp-app",
    "mcp-server",
    "docx",
    "word",
    "claude",
    "chatgpt",
    "editor"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "build": "bun run assets && bun run build:app && bun run build:server",
    "build:app": "node scripts/build-app.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "dev": "bun run assets && node scripts/dev.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "inspect": "bunx @modelcontextprotocol/inspector",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "start": "node dist/server/server/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docx-editor.dev/core": "^2.10.0",
    "@docx-editor.dev/editor-api": "^2.10.0",
    "@docx-editor.dev/pro": "^2.10.0",
    "@docx-editor.dev/react": "^2.10.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
