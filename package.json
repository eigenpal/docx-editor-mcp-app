{
  "name": "@docx-editor.dev/mcp-app",
  "version": "1.0.2",
  "description": "Word-faithful .docx viewer and editor for ChatGPT, Codex, and Claude, as an MCP App with OpenAI plugin extensions.",
  "author": "Eigenpal",
  "license": "SEE LICENSE IN LICENSE-PLUGIN.md",
  "homepage": "https://www.docx-editor.dev/mcp-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor-mcp-app.git"
  },
  "keywords": [
    "mcp",
    "mcp-app",
    "mcp-server",
    "docx",
    "word",
    "claude",
    "chatgpt",
    "editor"
  ],
  "type": "module",
  "bin": {
    "docx-editor-mcp-app": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/app",
    "assets",
    "skills",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".agents/plugins/marketplace.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE-PLUGIN.md",
    "docs/releases.md",
    "docs/submission/privacy.md",
    "docs/submission/terms.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:app && bun run build:cli && bun run build:notices",
    "build:app": "node scripts/build-app.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"skills/**/*.md\" \"docs/**/*.{md,json}\" \".codex-plugin/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"skills/**/*.md\" \"docs/**/*.{md,json}\" \".codex-plugin/*.json\"",
    "inspect": "bunx @modelcontextprotocol/inspector",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "start": "node dist/cli.js http",
    "stdio": "node dist/cli.js stdio",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "bun run build",
    "build:notices": "node scripts/build-notices.mjs",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test",
    "smoke": "node scripts/smoke-stdio.mjs",
    "build:directory": "node scripts/build-directory-plugin.mjs",
    "build:local": "bun run build && node scripts/build-local-packages.mjs && node scripts/build-marketplace.mjs",
    "build:claude": "node scripts/build-local-packages.mjs claude",
    "smoke:packages": "node scripts/smoke-local-packages.mjs",
    "engine:check": "node scripts/check-engine.mjs",
    "engine:update": "node scripts/check-engine.mjs --update",
    "release:version": "node scripts/release-version.mjs",
    "release:verify": "bun run typecheck && bun run lint && bun run test && bun run build:local && bun run smoke && bun run smoke:packages && bun run smoke:upgrade",
    "smoke:upgrade": "node scripts/smoke-upgrade.mjs"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "2.33.0",
    "@docx-editor.dev/pro": "2.33.0",
    "@docx-editor.dev/react": "2.33.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/mcp-extensions": "^0.1.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "^0.8.2",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.1.13"
  }
}
