# Dependencies
node_modules/

# Build outputs
dist/

# Build outputs under public/: the widget's hashed JS/CSS and the engine's
# HarfBuzz binary, all emitted by `bun run build:app`. Committing them would
# ship copies that silently drift from the installed engine — the wasm loader
# rejects a mismatched binary by design.
public/assets/

# Local verification harness (scripts/build-harness.mjs); dev-only, never shipped.
public/__harness/
public/preview.html
public/preview-files/

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Claude Code (local-only files)
.claude/settings.local.json
.claude/CLAUDE.local.md
.worktrees/

# IDE
.idea/
.vscode/
*.swp

# Logs
*.log

# Build info
*.tsbuildinfo

# Vercel
.vercel/

# Local verification screenshots (chrome-devtools harness runs)
screenshots-harness/

# npm lock file (using bun.lock)
package-lock.json
