# The public origin this server is reachable at.
#
# It is the ONE domain the widget's CSP allowlist names, and the widget uses it
# to fetch `harfbuzz.wasm` and to reach the `/fetch` proxy. Set it wrong and the
# engine cannot load HarfBuzz: it does not crash, it falls back, and pagination
# drifts away from Word.
#
# Local development defaults to http://localhost:$PORT, which is fine for the
# MCP Inspector but not for a real host — a host renders the widget in ITS
# browser, which cannot reach your localhost.
PUBLIC_ORIGIN=https://your-host.example

# Defaults to 3000.
PORT=3000
