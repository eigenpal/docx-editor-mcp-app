{
  // Server-only emit. The widget is bundled by esbuild
  // (scripts/build-app.mjs) and never passes through tsc.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/server",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["src/server/__tests__"]
}
